{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "outDir": "lib",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true
  },
  "exclude": ["node_modules","src/__tests__"]
}
